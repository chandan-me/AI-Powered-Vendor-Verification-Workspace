# ==============================================================================
# VendorVerify AI - Environment Configuration Example
# Copy this file to .env and configure your local settings
# ==============================================================================

# Database Configuration (MySQL 8+ recommended, SQLite also supported)
DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/vendorverify
# SQLite fallback example:
# DATABASE_URL=sqlite:///./vendorverify.db

# External AI & Corporate Registry APIs
# Note: Leave empty to run in built-in deterministic local regex/NLP demo mode!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENCORPORATES_API_TOKEN=

# Email Automation (Resend API or SMTP / Mailpit)
RESEND_API_KEY=
EMAIL_FROM=onboarding@vendorverify.ai
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Application Settings
APP_NAME="VendorVerify AI"
APP_ENV=development
SECRET_KEY=vendorverify-super-secret-key-change-in-production
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_SIZE_MB=10
DEMO_MODE=true
