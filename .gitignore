# ==============================================================================
# VendorVerify AI - Git Ignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Sensitive Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# Database Files
*.sqlite3
*.db
mysql_data/
*.sql.gz
*.dump

# Local Uploads & Storage (Keep sample_documents and gitkeep)
private_uploads/*
!private_uploads/.gitkeep
backend/private_uploads/*
!backend/private_uploads/.gitkeep

# Node / Frontend Build & Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Logs & Diagnostics
*.log
logs/
*.pid

# IDE & Editor Configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
